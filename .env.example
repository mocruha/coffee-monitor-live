# Copie para .env e ajuste. O .env NÃO vai para o Git (ver .gitignore).

# Connection string do Neon (PostgreSQL). Obrigatória para gravar/ler o banco.
# O host remoto recebe sslmode=require automaticamente (ver scrapers/base.py).
DATABASE_URL=postgresql://usuario:senha@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Contato real colocado no User-Agent (o AGENTS.md §5 pede identificação clara).
CAFE_CONTATO=seu-email@exemplo.com

# Opcional: também gravar o log em arquivo (padrão: apenas stdout).
# CAFE_LOG=/caminho/coleta.log
